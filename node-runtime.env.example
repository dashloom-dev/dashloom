# Vercel and AWS Next.js runtime configuration. Never commit real secrets.
# Use `d1` with the Cloudflare HTTP fields below, or `supabase` with
# SUPABASE_DATABASE_URL. Build with the matching npm script.
DASHLOOM_DATABASE=d1
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_D1_DATABASE_ID=your-d1-database-id
CLOUDFLARE_D1_API_TOKEN=your-dedicated-d1-read-write-api-token
# SUPABASE_DATABASE_URL=postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres
# SUPABASE_DATABASE_POOL_SIZE=5
# SUPABASE_DATABASE_SSL=disable # Only for trusted self-hosted/local Supabase without TLS.
# Deployment-wide default for authentication and newly created workspaces: en or zh-CN.
DASHLOOM_DEFAULT_LOCALE=en
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=https://your-dashloom-domain.example
CREDENTIALS_ENCRYPTION_KEY=replace-with-a-separate-random-secret-at-least-32-characters
REPORT_CRON_SECRET=replace-with-an-independent-random-secret-at-least-32-characters
AUTH_EMAIL_WEBHOOK_URL=https://your-transactional-email-relay.example/send
AUTH_EMAIL_WEBHOOK_SECRET=replace-with-your-email-relay-authentication-secret
AUTH_REQUIRE_EMAIL_VERIFICATION=false
