{
  "name": "dashloom-community",
  "version": "0.6.2",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "dev:next": "next dev",
    "build:next": "next build",
    "start:next": "next start",
    "dev:supabase": "node scripts/run-supabase-next.mjs dev",
    "build:supabase": "node scripts/run-supabase-next.mjs build",
    "start:supabase": "node scripts/run-supabase-next.mjs start",
    "vercel-build": "next build",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "db:generate": "drizzle-kit generate",
    "db:generate:supabase": "drizzle-kit generate --config drizzle.supabase.config.ts",
    "db:migrate:supabase": "drizzle-kit migrate --config drizzle.supabase.migrate.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply site-creator-d1 --local",
    "db:status:local": "wrangler d1 migrations list site-creator-d1 --local",
    "typecheck": "tsc --noEmit --incremental false",
    "typecheck:supabase": "tsc --noEmit -p tsconfig.supabase.json",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "validate:extensions": "node --experimental-strip-types scripts/validate-community-extensions.ts",
    "validate:connector-worker": "npm run check --prefix examples/cloudflare-connector-worker",
    "eval:agent": "node --experimental-strip-types scripts/evaluate-agent-fixtures.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.47",
    "@ai-sdk/react": "4.0.82",
    "@better-auth/drizzle-adapter": "1.7.1",
    "@cloudflare/ai-chat": "0.10.2",
    "agents": "0.21.0",
    "ai": "7.0.79",
    "better-auth": "1.7.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.34.0",
    "next": "16.3.3",
    "postgres": "3.4.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "22.5.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.1",
    "@cloudflare/workers-types": "5.20260825.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "7.0.2",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.125.0"
  },
  "type": "module"
}
