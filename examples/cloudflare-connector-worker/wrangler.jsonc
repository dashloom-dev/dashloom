{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dashloom-connector",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "DASHLOOM_URL": "https://your-dashloom.example",
    "DASHLOOM_PRODUCT_ID": "11111111-1111-4111-8111-111111111111",
    "SOURCE_NAME": "customer_d1",
    "LOOKBACK_DAYS": 3
  },
  "secrets": {
    "required": ["DASHLOOM_API_KEY"]
  },
  "d1_databases": [
    {
      "binding": "SOURCE_DB",
      "database_name": "replace-with-your-database-name",
      "database_id": "00000000-0000-4000-8000-000000000000"
    }
  ],
  "triggers": {
    "crons": ["7 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
